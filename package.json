{
  "name": "cc-connect-feishu-plus",
  "version": "0.2.2",
  "description": "Automatic privacy-safe Feishu turn cards for CC Connect",
  "type": "module",
  "bin": {
    "cc-connect-feishu-plus": "dist/cli.js"
  },
  "files": [
    "dist/*.js",
    "dist/*.js.map",
    "dist/*.d.ts",
    "dist/*.d.ts.map",
    "dist/runtime/*.mjs",
    "README.md",
    "CHANGELOG.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "scripts": {
    "clean": "node --eval \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc -p tsconfig.json && npm run build:runtime",
    "build:runtime": "esbuild src/codex-proxy.ts --bundle --platform=node --format=esm --target=node20 --outfile=dist/runtime/codex-proxy.mjs",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test dist/test/*.test.js",
    "prepare": "npm run build",
    "prepack": "npm run test"
  },
  "keywords": [
    "cc-connect",
    "feishu",
    "lark",
    "agent-proxy",
    "rich-card"
  ],
  "author": "timmyagentic",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/timmyagentic/cc-connect-feishu-plus.git"
  },
  "bugs": {
    "url": "https://github.com/timmyagentic/cc-connect-feishu-plus/issues"
  },
  "homepage": "https://github.com/timmyagentic/cc-connect-feishu-plus#readme",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "smol-toml": "1.8.0"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "esbuild": "0.25.12",
    "typescript": "5.9.3"
  }
}
